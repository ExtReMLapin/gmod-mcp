# Generates a C++ header containing each src/lua/*.lua file as a byte array (alphabetical order).
file(GLOB files "${SRC_DIR}/*.lua")
list(SORT files)
set(out "// Generated by cmake/embed_lua.cmake - do not edit.\n#pragma once\n#include <cstddef>\nnamespace embedded {\nstruct LuaChunk { const char *name; const unsigned char *data; size_t size; };\n")
set(table "")
set(i 0)
foreach(f ${files})
  get_filename_component(name ${f} NAME)
  file(READ ${f} hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND out "static const unsigned char chunk_${i}[] = {${bytes} 0x00};\n")
  string(APPEND table "  {\"${name}\", chunk_${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND out "static const LuaChunk lua_chunks[] = {\n${table}};\nstatic const size_t lua_chunk_count = ${i};\n}  // namespace embedded\n")
file(WRITE ${OUT} "${out}")
