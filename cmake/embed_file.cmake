# Generates a C++ header holding one file as a byte array: cmake -DIN=<file> -DOUT=<header> -DNAME=<identifier> -P ...
file(READ ${IN} hex HEX)
string(LENGTH "${hex}" hexlen)
math(EXPR size "${hexlen} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
file(WRITE ${OUT} "// Generated by cmake/embed_file.cmake - do not edit.\n#pragma once\n#include <cstddef>\n"
                  "static const unsigned char ${NAME}[] = {${bytes} 0x00};\nstatic const size_t ${NAME}_size = ${size};\n")
